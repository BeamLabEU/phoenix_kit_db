<div class="container flex-col mx-auto px-4 py-6">
    <.admin_page_header back={PhoenixKitDb.Paths.index()}>
      <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-base-content">
        {@schema}.{@table}
      </h1>
      <p class="text-sm text-base-content/60 mt-0.5">
        <.formatted_number number={@preview.approx_rows} format={:short} /> {ngettext(
          "row",
          "rows",
          @preview.approx_rows
        )} • <.file_size bytes={@preview.size_bytes} />
      </p>
    </.admin_page_header>

    <%!-- Actions --%>
    <div class="flex justify-end mb-6">
      <.link
        navigate={"#{PhoenixKitDb.Paths.activity()}?#{URI.encode_query(%{"table" => "#{@schema}.#{@table}"})}"}
        class="btn btn-ghost btn-sm"
      >
        <.icon name="hero-signal" class="w-4 h-4 mr-2" /> {gettext("Live Activity")}
      </.link>
    </div>

    <div
      :if={@live_updates == :unavailable}
      id="db-live-updates-unavailable"
      class="alert alert-warning mb-4 text-sm"
    >
      <.icon name="hero-exclamation-triangle" class="w-4 h-4" />
      <span>
        {gettext(
          "Live updates are not available for this table right now. The rows below are current as of this page load; reload to try again."
        )}
      </span>
    </div>

    <div class="bg-base-100 rounded-box shadow border border-base-200">
      <div class="p-4 border-b border-base-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
          <span
            id="db-row-total"
            class="text-sm text-base-content/70"
            data-approximate={to_string(@preview.row_count_approx)}
          >
            <%= if @preview.row_count_approx do %>
              {ngettext(
                "about %{count} row total (estimate)",
                "about %{count} rows total (estimate)",
                @preview.row_count
              )}
            <% else %>
              {@preview.row_count} {ngettext("row total", "rows total", @preview.row_count)}
            <% end %>
          </span>
          <.form for={%{}} id="db-per-page" phx-change="set_per_page" class="flex items-center gap-2">
            <span class="text-sm text-base-content/70">{gettext("Show")}</span>
            <label class="select select-sm w-20">
              <select name="per_page">
                <%= for option <- [10, 20, 50, 100, 200] do %>
                  <option value={option} selected={option == @per_page}>{option}</option>
                <% end %>
              </select>
            </label>
            <span class="text-sm text-base-content/70">{gettext("per page")}</span>
          </.form>
        </div>
        <div class="flex items-center gap-2">
          <div class="join">
            <button
              class="join-item btn btn-sm"
              phx-click="change_page"
              phx-value-page="1"
              disabled={@preview.page <= 1}
              title={gettext("First page")}
            >
              <.icon name="hero-chevron-double-left" class="w-4 h-4" />
            </button>
            <button
              class="join-item btn btn-sm"
              phx-click="change_page"
              phx-value-page={@preview.page - 1}
              disabled={@preview.page <= 1}
              title={gettext("Previous page")}
            >
              <.icon name="hero-chevron-left" class="w-4 h-4" />
            </button>
            <span class="join-item btn btn-sm btn-disabled !text-base-content">
              {gettext("Page %{page} of %{total}",
                page: @preview.page,
                total: @preview.total_pages
              )}
            </span>
            <button
              class="join-item btn btn-sm"
              phx-click="change_page"
              phx-value-page={@preview.page + 1}
              disabled={@preview.page >= @preview.total_pages}
              title={gettext("Next page")}
            >
              <.icon name="hero-chevron-right" class="w-4 h-4" />
            </button>
            <button
              class="join-item btn btn-sm"
              phx-click="change_page"
              phx-value-page={@preview.total_pages}
              disabled={@preview.page >= @preview.total_pages}
              title={gettext("Last page")}
            >
              <.icon name="hero-chevron-double-right" class="w-4 h-4" />
            </button>
          </div>
        </div>
      </div>

      <div
        id="db-table-scroller"
        class="relative"
        phx-hook="PhoenixKitDbTableScroller"
        data-page={@preview.page}
        data-total-pages={@preview.total_pages}
      >
        <%!-- Fake scrollbar container --%>
        <div class="flex">
          <%!-- Table content --%>
          <div id="table-container" class="overflow-x-auto">
            <table class="table table-zebra table-xs [&_th]:py-1 [&_td]:py-0.5">
              <thead>
                <tr>
                  <%= for column <- @preview.columns do %>
                    <th class="text-xs uppercase tracking-wide text-base-content/70">
                      {column.name}
                    </th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <%= if Enum.empty?(@preview.rows) do %>
                  <tr>
                    <td
                      colspan={length(@preview.columns)}
                      class="text-center !py-8 text-base-content/70"
                    >
                      {gettext("No rows found.")}
                    </td>
                  </tr>
                <% else %>
                  <%= for {row, index} <- Enum.with_index(@preview.rows) do %>
                    <tr class={
                      row_highlighted?(row, index, @preview.primary_key, @highlighted_rows) &&
                        "animate-highlight"
                    }>
                      <%= for column <- @preview.columns do %>
                        <% value = Map.get(row, column.name) %>
                        <td class="align-middle max-w-xs truncate">
                          <%= if is_nil(value) do %>
                            <span class="text-base-content/40 italic">{gettext("null")}</span>
                          <% else %>
                            {format_cell(value)}
                          <% end %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                  <%!-- Empty placeholder rows to maintain consistent height --%>
                  <% empty_rows = @per_page - length(@preview.rows) %>
                  <%= if empty_rows > 0 do %>
                    <%= for _i <- 1..empty_rows do %>
                      <tr class="invisible">
                        <%= for _column <- @preview.columns do %>
                          <td class="align-middle">&nbsp;</td>
                        <% end %>
                      </tr>
                    <% end %>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>

          <%!-- Fake scrollbar with page markers --%>
          <%= if @preview.total_pages > 1 do %>
            <div
              id="scrollbar-container"
              class="relative flex-shrink-0 self-stretch"
              style={"--total-pages: #{@preview.total_pages}"}
            >
              <% zone_offset = 50 / @preview.total_pages %>
              <div
                id="page-markers"
                class="absolute right-5 w-12 pointer-events-none opacity-0 transition-opacity duration-150"
                style={"top: #{zone_offset}%; bottom: #{zone_offset}%;"}
              >
                <%= for page <- page_markers(@preview.total_pages) do %>
                  <div
                    class="page-marker absolute right-0 font-medium text-base-content bg-base-100 px-1 rounded shadow-sm border border-base-300 -translate-y-1/2 origin-right transition-transform duration-75"
                    data-page={page}
                    style={"top: #{if @preview.total_pages > 1, do: (page - 1) / (@preview.total_pages - 1) * 100, else: 0}%; font-size: 8px;"}
                  >
                    {page}
                  </div>
                <% end %>
              </div>
              <div
                id="fake-scrollbar"
                class="w-4 h-full bg-base-200 overflow-y-scroll"
                phx-update="ignore"
              >
                <div id="fake-scrollbar-content" style="height: calc(var(--total-pages) * 100%);">
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes row-highlight {
      0% { background-color: oklch(0.85 0.15 140); }
      100% { background-color: transparent; }
    }
    .animate-highlight {
      animation: row-highlight 3s ease-out;
    }
    .animate-highlight td {
      background-color: inherit !important;
    }
  </style>
